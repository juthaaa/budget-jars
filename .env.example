# Local development (SQLite file). Used when TURSO_DATABASE_URL is not set.
DATABASE_URL="file:./prisma/dev.db"

# Production (Vercel) — Turso / libSQL. Leave unset locally to use the file above.
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<your-token>"

# Auth — secret for signing the session JWT (REQUIRED in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-dev-secret"

# Session sliding-expiry in minutes (optional, default 60).
# SESSION_TTL_MINUTES="60"

# LINE bot (Phase 1) — from the LINE Developers Console, Messaging API channel.
LINE_CHANNEL_SECRET="change-me"
LINE_CHANNEL_ACCESS_TOKEN="change-me"

# LIFF — opening the app from a LINE rich menu, with auto sign-in.
# Both come from a LINE Login channel that MUST live under the same provider as
# the Messaging API channel above: LINE user ids are scoped per provider, so a
# channel in another provider yields ids that never match User.lineUserId.
# LIFF app scopes must include "openid" or getIDToken() returns null.
NEXT_PUBLIC_LIFF_ID="change-me"       # LIFF tab → LIFF ID, e.g. 1234567890-abcdefgh
LINE_LOGIN_CHANNEL_ID="change-me"     # Basic settings → Channel ID (digits only)

# AI classifier — Anthropic API key for the LINE message parser.
ANTHROPIC_API_KEY="change-me"
# AI_PROVIDER="anthropic"   # only "anthropic" is implemented so far
