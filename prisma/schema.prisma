generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Every table below carries a `userId`. There is no shared/global data: a row is
// only ever visible to the user that owns it, and every API route scopes its
// queries by the session's uid (see lib/auth.ts). Codes that used to be globally
// unique (jar code, payment-method code, …) are now unique per user, so two users
// can both have a "NEC" jar.
model User {
  id                    Int       @id @default(autoincrement())
  username              String    @unique
  passwordHash          String
  // LINE Messaging API userId. The webhook has no session cookie, so this is the
  // only way it can tell whose transaction a message is. Set either by the
  // in-chat link code below or by scripts/link-line-user.ts.
  lineUserId            String?   @unique
  // One-shot code the user generates on /line and sends to the bot as
  // "link 123456" — that message arrives with a verified LINE userId, which is
  // what makes the claim trustworthy. Both fields are cleared once consumed.
  lineLinkCode          String?   @unique
  lineLinkCodeExpiresAt DateTime?
  createdAt             DateTime  @default(now())

  bankAccounts       BankAccount[]
  expenseMasters     ExpenseMaster[]
  installmentPlans   InstallmentPlan[]
  loanPlans          LoanPlan[]
  loanRateBands      LoanRateBand[]
  loanPrepayments    LoanPrepayment[]
  loanReferenceRates LoanReferenceRate[]
  recurringExpenses  RecurringExpense[]
  jars               Jar[]
  monthlyRecords     MonthlyRecord[]
  incomeTypes        IncomeType[]
  paymentMethods     PaymentMethod[]
  paymentSettlements MonthlyPaymentSettlement[]
  bankTransfers      MonthlyBankTransfer[]
  monthlyIncomes     MonthlyIncome[]
  deductionTypes     DeductionType[]
  deductionRules     DeductionRule[]
  monthlyDeductions  MonthlyDeduction[]
  jarAllocations     JarAllocation[]
  expenses           Expense[]
  salaryHistory      SalaryHistory[]
  transactions       Transaction[]
}

model BankAccount {
  id               Int                   @id @default(autoincrement())
  userId           Int
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  accountNumber    String?
  color            String                @default("#6366f1")
  jars             Jar[]
  expenses         Expense[]
  expenseMasters   ExpenseMaster[]
  jarAllocations   JarAllocation[]
  bankTransfers    MonthlyBankTransfer[]
  paymentMethods   PaymentMethod[]
  unassignedMonths MonthlyRecord[]

  @@index([userId])
}

model ExpenseMaster {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  defaultJarCode String?
  bankAccountId  Int?
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  sortOrder      Int          @default(0)

  @@index([userId])
}

model InstallmentPlan {
  id                Int                @id @default(autoincrement())
  userId            Int
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  jarCode           String
  principalAmount   Float
  totalInstallments Int
  interestRate      Float              @default(0)
  interestUnit      String             @default("month")
  paymentMethodId   Int?
  paymentMethod     PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  startDate         DateTime
  note              String?
  sortOrder         Int                @default(0)
  items             RecurringExpense[]

  @@index([userId])
}

// A home/car loan with a stepped-rate schedule (fixed bands + reference-rate
// linked bands, e.g. MRR/MLR/MOR ± spread) and optional prepayment ("โปะ").
// Generic across banks — every rate is config, nothing about MRTA or any
// specific promotion is hardcoded. See lib/loan-schedule.ts for the pure
// calculation engine and source/CLAUDE.md's "Loan Plan System" section for
// the full data-flow writeup.
//
// Like InstallmentPlan, this owns N child RecurringExpense rows (one per
// installment, reusing installmentNumber) rather than a bespoke child table —
// Expense.recurringExpenseId is the only "already seeded" sentinel the rest
// of the system understands, and reusing it is what makes the monthly
// auto-seed path, the settlement lock, and the seeded/unseeded edit lock all
// work for free.
model LoanPlan {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  jarCode         String
  paymentMethodId Int?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  principalAmount  Float
  termMonths       Int
  startDate        DateTime // วันที่เริ่มสัญญา/เบิกเงินกู้ — can be any day of month
  // Due date of installment #1; every later installment falls on the same
  // day-of-month, one calendar month apart. Null = defaults to exactly one
  // month after startDate (no stub period). When it doesn't line up with
  // startDate + 1 month, the gap becomes a short/long first period whose
  // interest is prorated by actual days instead of the usual ÷12
  // approximation — see lib/loan-schedule.ts's stub-period handling.
  firstPaymentDate DateTime?

  interestMode String @default("monthly") // monthly (÷12) | daily (×days/365)

  // Optional monthly fee riding alongside the loan (e.g. MRTA credit-life
  // insurance) — deliberately generic, not principal/interest on the loan
  // itself. Materialized as its own plain RecurringExpense (see
  // monthlyFeeRecurringExpenseId) so it shows up normally on
  // /recurring-expenses/manage instead of polluting the amortization math.
  monthlyFeeAmount             Float?
  monthlyFeeMonths             Int?
  monthlyFeeRecurringExpenseId Int?   @unique

  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands          LoanRateBand[]
  prepayments    LoanPrepayment[]
  referenceRates LoanReferenceRate[]
  items          RecurringExpense[]

  @@index([userId])
}

// A time-varying reference rate (MRR/MLR/MOR/…) used by ref_spread bands.
// Stored as a timeline, not a single value, so it can be updated yearly (or
// whenever the bank actually moves it) without losing the history that past
// installments were priced against.
model LoanReferenceRate {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanPlanId    Int
  loanPlan      LoanPlan @relation(fields: [loanPlanId], references: [id], onDelete: Cascade)
  code          String // "MRR" | "MLR" | "MOR" | user-defined
  value         Float
  effectiveFrom DateTime
  isAssumption  Boolean  @default(false) // true = user-entered future guess, not an observed rate
  note          String?

  @@index([userId])
  @@index([loanPlanId, code, effectiveFrom])
}

// One rung of the stepped-rate ladder. rateType "absolute" uses `value`
// directly; "ref_spread" adds `value` (usually negative) to whichever
// LoanReferenceRate.code = refCode is effective on a given installment's due
// date. paymentOverride pins the monthly payment to what the bank actually
// quotes (PAYDEF-style) for that band; when left null the engine falls back
// to computing PMT off the balance at band start over the months remaining
// to the end of the contract.
model LoanRateBand {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanPlanId      Int
  loanPlan        LoanPlan @relation(fields: [loanPlanId], references: [id], onDelete: Cascade)
  fromInstallment Int // 1-based, inclusive
  toInstallment   Int? // null = to end of term
  rateType        String // absolute | ref_spread
  refCode         String?
  value           Float // absolute rate (2.49) or spread (-0.750)
  paymentOverride Float?
  label           String?
  sortOrder       Int      @default(0)

  @@index([userId])
  @@index([loanPlanId, fromInstallment])
}

// A prepayment ("โปะ") applied on top of the scheduled payment. Multiple
// rows can overlap (e.g. +1,000/month for installments 1-24 plus a one-off
// 50,000 at installment 13) — the engine sums whatever covers a given month.
model LoanPrepayment {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanPlanId      Int
  loanPlan        LoanPlan @relation(fields: [loanPlanId], references: [id], onDelete: Cascade)
  kind            String // recurring | one_off
  fromInstallment Int
  toInstallment   Int? // recurring only; null = until payoff
  amount          Float
  note            String?

  @@index([userId])
  @@index([loanPlanId, fromInstallment])
}

model RecurringExpense {
  id                Int              @id @default(autoincrement())
  userId            Int
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  jarCode           String
  amount            Float
  startDate         DateTime?
  endDate           DateTime?
  paymentMethodId   Int?
  paymentMethod     PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  sortOrder         Int              @default(0)
  note              String?
  intervalValue     Int              @default(1)
  intervalUnit      String           @default("month")
  installmentPlanId Int?
  installmentPlan   InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  installmentNumber Int?
  loanPlanId        Int?
  loanPlan          LoanPlan?        @relation(fields: [loanPlanId], references: [id], onDelete: Cascade)
  // "installment" | "prepay" — null for anything that isn't a LoanPlan child.
  // A loan installment owns up to two children with the same
  // `installmentNumber`: the scheduled payment and (when the plan has a
  // prepayment covering that month) the โปะ. They seed into the month as two
  // separate Expense rows so a month where the prepayment wasn't actually made
  // can have just that row deleted.
  loanItemKind      String?
  expenses          Expense[]

  @@index([userId])
}

model Jar {
  id            Int             @id @default(autoincrement())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  code          String
  jarType       String          @default("a")
  bankAccountId Int?
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id])
  percentage    Float           @default(0)
  rules         String?
  isNec         Boolean         @default(false)
  sortOrder     Int             @default(0)
  allocations   JarAllocation[]

  @@unique([userId, code])
  @@index([userId])
}

model MonthlyRecord {
  id                      Int                        @id @default(autoincrement())
  userId                  Int
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  year                    Int
  month                   Int
  necAmount               Float                      @default(0)
  necIsManual             Boolean                    @default(false)
  reconciled              Boolean                    @default(false)
  unassignedBankAccountId Int?
  unassignedBankAccount   BankAccount?               @relation(fields: [unassignedBankAccountId], references: [id], onDelete: SetNull)
  allocations             JarAllocation[]
  expenses                Expense[]
  deductions              MonthlyDeduction[]
  monthlyIncomes          MonthlyIncome[]
  paymentSettlements      MonthlyPaymentSettlement[]
  bankTransfers           MonthlyBankTransfer[]

  @@unique([userId, year, month])
  @@index([userId])
}

model IncomeType {
  id             Int             @id @default(autoincrement())
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  code           String
  excludeFromNet Boolean         @default(false)
  sortOrder      Int             @default(0)
  monthlyIncomes MonthlyIncome[]

  @@unique([userId, code])
  @@index([userId])
}

model PaymentMethod {
  id                 Int                        @id @default(autoincrement())
  userId             Int
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  code               String
  sortOrder          Int                        @default(0)
  bankAccountId      Int?
  bankAccount        BankAccount?               @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdAt          DateTime                   @default(now())
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  installmentPlans   InstallmentPlan[]
  loanPlans          LoanPlan[]
  monthlySettlements MonthlyPaymentSettlement[]

  @@unique([userId, code])
  @@index([userId])
}

model MonthlyPaymentSettlement {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyRecordId Int
  monthlyRecord   MonthlyRecord @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  paidAt          DateTime?
  reconciledAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([monthlyRecordId, paymentMethodId])
  @@index([userId])
}

model MonthlyBankTransfer {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyRecordId Int
  monthlyRecord   MonthlyRecord @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  bankAccountId   Int
  bankAccount     BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transferredAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([monthlyRecordId, bankAccountId])
  @@index([userId])
}

model MonthlyIncome {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyRecordId Int
  monthlyRecord   MonthlyRecord @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  incomeTypeId    Int
  incomeType      IncomeType    @relation(fields: [incomeTypeId], references: [id], onDelete: Cascade)
  amount          Float         @default(0)

  @@unique([monthlyRecordId, incomeTypeId])
  @@index([userId])
}

model DeductionType {
  id                Int                @id @default(autoincrement())
  userId            Int
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  code              String
  sortOrder         Int                @default(0)
  rules             DeductionRule[]
  monthlyDeductions MonthlyDeduction[]

  @@unique([userId, code])
  @@index([userId])
}

model DeductionRule {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deductionTypeId Int
  deductionType   DeductionType @relation(fields: [deductionTypeId], references: [id], onDelete: Cascade)
  valueType       String        @default("amount")
  value           Float         @default(0)
  effectiveDate   DateTime

  @@index([userId])
}

model MonthlyDeduction {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyRecordId Int
  monthlyRecord   MonthlyRecord @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  deductionTypeId Int
  deductionType   DeductionType @relation(fields: [deductionTypeId], references: [id], onDelete: Cascade)
  amount          Float         @default(0)

  @@unique([monthlyRecordId, deductionTypeId])
  @@index([userId])
}

model JarAllocation {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyRecordId Int
  monthlyRecord   MonthlyRecord @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  jarId           Int
  jar             Jar           @relation(fields: [jarId], references: [id])
  amount          Float         @default(0)
  percentage      Float? // per-month override; null = use jar default
  bankAccountId   Int? // per-month override; null = use jar.bankAccountId
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@unique([monthlyRecordId, jarId])
  @@index([userId])
}

model Expense {
  id                 Int               @id @default(autoincrement())
  userId             Int
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyRecordId    Int
  monthlyRecord      MonthlyRecord     @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  name               String
  jarCode            String
  amount             Float
  isLocked           Boolean           @default(false)
  bankAccountId      Int?
  bankAccount        BankAccount?      @relation(fields: [bankAccountId], references: [id])
  note               String?
  expenseDate        DateTime?
  paymentMethodId    Int?
  paymentMethod      PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  recurringExpenseId Int?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model SalaryHistory {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  amount        Float

  @@index([userId])
}

// Transactions captured from outside the web app (LINE bot for now, email later).
// Deliberately standalone — no relations to the models above (apart from the
// owning User) — so the bot can record a message even when its MonthlyRecord does
// not exist yet. Phase 2 seeds these into Expense once the month is created.
model Transaction {
  id         Int     @id @default(autoincrement())
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String  @default("line") // line | email | manual
  // LINE webhookEventId — globally unique across users, so it stays a plain
  // unique index rather than a per-user one; that lets the webhook dedupe a
  // retried delivery before it has resolved which user sent it.
  externalId String? @unique
  rawText    String // original user message
  parsed     String? // raw JSON from the classifier, for replay after prompt changes
  confidence Float?
  status     String  @default("pending") // pending | failed | ignored ("applied" in phase 2)

  direction         String // "in" (income) | "out" (expense)
  name              String
  amount            Float // always positive — direction carries the sign
  jarCode           String? // suggested by AI, validated against Jar.code
  note              String?
  paymentMethodCode String? // suggested by AI, validated against PaymentMethod.code

  // Kept for phase 2. Plain Ints, not FKs, to avoid coupling with the existing models.
  paymentMethodId Int?
  bankAccountId   Int?

  occurredAt DateTime // UTC
  year       Int // derived from occurredAt — used to match a MonthlyRecord later
  month      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, year, month, status])
  @@index([userId, direction, occurredAt])
  @@index([userId])
}
